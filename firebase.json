{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "deploy/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), microphone=(), camera=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=63072000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "resources/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          },
          { "key": "X-Robots-Tag", "value": "index, follow" }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "sitemap-images.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "robots.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "llms.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "X-Robots-Tag", "value": "index, follow" }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/gut-gastrointestinal-tests.html",
        "destination": "/gastrointestinal-tests",
        "type": 301
      },
      {
        "source": "/gut-gastrointestinal-tests",
        "destination": "/gastrointestinal-tests",
        "type": 301
      },
      {
        "source": "/clinical-insights.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/clinical-insights",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/insight-stool-inflammatory-markers.html",
        "destination": "/gastrointestinal-tests",
        "type": 301
      },
      {
        "source": "/insight-stool-inflammatory-markers",
        "destination": "/gastrointestinal-tests",
        "type": 301
      },
      {
        "source": "/insight-marcons-culture-testing.html",
        "destination": "/nasal-throat-tests#marcons",
        "type": 301
      },
      {
        "source": "/insight-marcons-culture-testing",
        "destination": "/nasal-throat-tests#marcons",
        "type": 301
      },
      {
        "source": "/insight-pcr-and-culture-together.html",
        "destination": "/gastrointestinal-tests",
        "type": 301
      },
      {
        "source": "/insight-pcr-and-culture-together",
        "destination": "/gastrointestinal-tests",
        "type": 301
      },
      {
        "source": "/clia-credentials.html",
        "destination": "/clia-credentials",
        "type": 301
      },
      {
        "source": "/billing-policies.html",
        "destination": "/billing-policies",
        "type": 301
      },
      {
        "source": "/resources/F_(Forms)/F0_RSM—Account_Requisition_Form.pdf",
        "destination": "/resources/F_(Forms)/F1_RSM—Account_Requisition_Form.pdf",
        "type": 301
      },
      {
        "source": "/resources/F_(Forms)/F1_RSM—Bulk_Shipment_Request_Form.pdf",
        "destination": "/resources/F_(Forms)/F2_RSM—Bulk_Shipment_Request_Form.pdf",
        "type": 301
      },
      {
        "source": "/resources/F_(Forms)/F2_RSM—Patient_Direct_Drop_Shipment_Request_Form.pdf",
        "destination": "/resources/F_(Forms)/F3_RSM—Patient_Direct_Drop_Shipment_Request_Form.pdf",
        "type": 301
      },
      {
        "source": "/resources/B_(Marketing-Material)/B1_TGI_Comparison_Table-PROVIDER-FACING.pdf",
        "destination": "/resources/B_(Marketing-Material)/B2_rsm_total_gi_vs_egha_provider_handout.pdf",
        "type": 301
      },
      {
        "source": "/resources/F_(Forms)/F2__RSM—Patient_Direct_Drop_Shipment_Request_Form.pdf",
        "destination": "/resources/F_(Forms)/F3_RSM—Patient_Direct_Drop_Shipment_Request_Form.pdf",
        "type": 301
      },
      {
        "source": "**",
        "destination": "/404.html",
        "type": 404
      }
    ]
  }
}
