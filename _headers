# Netlify / Cloudflare Pages response headers
# Technical authorship: Lucas J. Cooke, Partner Relations Coordinator. Contact: l.jcooke@icloud.com. LinkedIn: https://www.linkedin.com/in/lucas-cooke/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://aiwebsitedetector.com https://community.mis.temple.edu https://*.temple.edu https://app.joinhandshake.com https://*.joinhandshake.com https://joinhandshake-production.imgix.net https://*.imgix.net https://media.licdn.com https://static.licdn.com https://*.licdn.com; font-src 'self'; connect-src 'self' https://api.microlink.io; frame-src 'self' https://docs.google.com; form-action 'self' https://docs.google.com mailto:; upgrade-insecure-requests

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Clinical PDFs are indexable assets that rank for long-tail queries
/resources/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  X-Robots-Tag: index, follow

/styles.css
