<?xml version="1.0" encoding="UTF-8"?>
<!-- RSM Diagnostics Lab - IIS / Windows hosting production configuration
     Technical authorship: Lucas J. Cooke, Partner Relations Coordinator. Contact: l.jcooke@icloud.com. LinkedIn: https://www.linkedin.com/in/lucas-cooke/ -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://www.rsmdiagnosticslab.com/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Force www host" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\." negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.rsmdiagnosticslab.com/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Collapse index.html" stopProcessing="true">
          <match url="^index\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy gastrointestinal URL" stopProcessing="true">
          <match url="^gut-gastrointestinal-tests(\.html)?$" />
          <action type="Redirect" url="/gastrointestinal-tests" redirectType="Permanent" />
        </rule>
        <rule name="Retire clinical insights hub" stopProcessing="true">
          <match url="^clinical-insights(\.html)?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Retire stool markers insight" stopProcessing="true">
          <match url="^insight-stool-inflammatory-markers(\.html)?$" />
          <action type="Redirect" url="/gastrointestinal-tests" redirectType="Permanent" />
        </rule>
        <rule name="Retire MARCoNS insight" stopProcessing="true">
          <match url="^insight-marcons-culture-testing(\.html)?$" />
          <action type="Redirect" url="/nasal-throat-tests#marcons" redirectType="Permanent" />
        </rule>
        <rule name="Retire PCR culture insight" stopProcessing="true">
          <match url="^insight-pcr-and-culture-together(\.html)?$" />
          <action type="Redirect" url="/gastrointestinal-tests" redirectType="Permanent" />
        </rule>
        <rule name="Legacy B1 provider PDF" stopProcessing="true">
          <match url="^resources/B_\(Marketing-Material\)/B1_TGI_Comparison_Table-PROVIDER-FACING\.pdf$" />
          <action type="Redirect" url="/resources/B_(Marketing-Material)/B2_rsm_total_gi_vs_egha_provider_handout.pdf" redirectType="Permanent" />
        </rule>
        <rule name="Legacy F0 form PDF" stopProcessing="true">
          <match url="^resources/F_\(Forms\)/F0_RSM—Account_Requisition_Form\.pdf$" />
          <action type="Redirect" url="/resources/F_(Forms)/F1_RSM—Account_Requisition_Form.pdf" redirectType="Permanent" />
        </rule>
        <rule name="Legacy F1 form PDF" stopProcessing="true">
          <match url="^resources/F_\(Forms\)/F1_RSM—Bulk_Shipment_Request_Form\.pdf$" />
          <action type="Redirect" url="/resources/F_(Forms)/F2_RSM—Bulk_Shipment_Request_Form.pdf" redirectType="Permanent" />
        </rule>
        <rule name="Legacy F2 form PDF" stopProcessing="true">
          <match url="^resources/F_\(Forms\)/F2_RSM—Patient_Direct_Drop_Shipment_Request_Form\.pdf$" />
          <action type="Redirect" url="/resources/F_(Forms)/F3_RSM—Patient_Direct_Drop_Shipment_Request_Form.pdf" redirectType="Permanent" />
        </rule>
        <rule name="Legacy F2 double-underscore form PDF" stopProcessing="true">
          <match url="^resources/F_\(Forms\)/F2__RSM—Patient_Direct_Drop_Shipment_Request_Form\.pdf$" />
          <action type="Redirect" url="/resources/F_(Forms)/F3_RSM—Patient_Direct_Drop_Shipment_Request_Form.pdf" redirectType="Permanent" />
        </rule>
        <rule name="Redirect html extension" stopProcessing="true">
          <match url="^(.+)\.html$" />
          <conditions>
            <add input="{URL}" pattern="^/404\.html$" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Serve extensionless html" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}.html" />
        </rule>
      </rules>
    </rewrite>

    <directoryBrowse enabled="false" />

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
        <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains; preload" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="_headers" />
          <add segment="_redirects" />
          <add segment="vercel.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
